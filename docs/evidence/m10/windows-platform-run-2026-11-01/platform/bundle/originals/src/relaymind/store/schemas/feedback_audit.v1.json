{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://relaymind.local/schemas/feedback_audit.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "audit_id", "scope", "adapter_id", "timestamp", "operation", "feedback_revision", "removed_count", "idempotency_digest"],
  "properties": {
    "schema_version": {"const": 1},
    "audit_id": {"type": "string", "format": "uuid"},
    "scope": {"type": "object", "additionalProperties": false, "required": ["user_id", "workspace_id"], "properties": {"user_id": {"type": "string", "minLength": 1, "maxLength": 256}, "workspace_id": {"type": "string", "minLength": 1, "maxLength": 256}}},
    "adapter_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "timestamp": {"type": "string", "format": "date-time"},
    "operation": {"enum": ["delete", "reset", "retention"]},
    "feedback_revision": {"type": "integer", "minimum": 0},
    "removed_count": {"type": "integer", "minimum": 0},
    "idempotency_digest": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^[0-9a-f]{64}$"}]}
  }
}
