{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://relaymind.local/schemas/route_decision.v1.json",
  "title": "RouteDecision",
  "description": "Normalized routing decision produced by the local router (spec section 8, RM02). Unknown fields are rejected. The rules that depend on the run (managed or client-owned catalog, execution mode, enabled parallel workflow) are checked by the validator with a RoutingContext and are not expressible here.",
  "type": "object",
  "properties": {
    "schema_version": {"const": 1},
    "route": {"enum": ["local", "external", "clarify", "parallel"]},
    "skill_id": {"type": ["string", "null"], "minLength": 1, "pattern": "\\S"},
    "language": {"enum": ["en", "zh"]},
    "reason_code": {
      "enum": [
        "simple_skill",
        "complex_skill",
        "missing_input",
        "local_budget",
        "invalid_output",
        "tool_failure",
        "context_limit",
        "capability_missing",
        "parallel_workflow",
        "execution_mode",
        "local_slow",
        "no_local_model",
        "selection_failed"
      ]
    },
    "clarification": {"type": ["string", "null"], "minLength": 1, "pattern": "\\S"}
  },
  "required": [
    "schema_version",
    "route",
    "skill_id",
    "language",
    "reason_code",
    "clarification"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {"properties": {"route": {"const": "clarify"}}},
      "then": {"properties": {"clarification": {"type": "string"}}},
      "else": {"properties": {"clarification": {"type": "null"}}}
    },
    {
      "description": "The reason code follows the route (spec 0.31 section 8). local_budget, invalid_output, and tool_failure are escalation reasons, never a route's.",
      "if": {"properties": {"route": {"const": "local"}}},
      "then": {"properties": {"reason_code": {"const": "simple_skill"}}}
    },
    {
      "if": {"properties": {"route": {"const": "clarify"}}},
      "then": {"properties": {"reason_code": {"const": "missing_input"}}}
    },
    {
      "if": {"properties": {"route": {"const": "parallel"}}},
      "then": {"properties": {"reason_code": {"const": "parallel_workflow"}}}
    },
    {
      "if": {"properties": {"route": {"const": "external"}}},
      "then": {
        "properties": {
          "reason_code": {
            "enum": [
              "complex_skill",
              "parallel_workflow",
              "context_limit",
              "execution_mode",
              "capability_missing",
              "no_local_model",
              "local_slow",
              "selection_failed"
            ]
          }
        }
      }
    }
  ]
}
