{
  "plugins": {
    "entries": {
      "relaymind": {
        "enabled": true,
        "config": {
          "baseUrl": "${RELAYMIND_BASE_URL}"
        }
      },
      "relaymind-test-host-tools": {
        "enabled": true
      }
    }
  },
  "meta": {
    "migrations": {
      "modelPolicyAllowlist": true,
      "utilityModelSeparation": true
    },
    "lastTouchedVersion": "2026.10.7"
  },
  "models": {
    "providers": {
      "relaymind": {
        "baseUrl": "${RELAYMIND_BASE_URL}",
        "api": "openai-completions",
        "models": [
          {
            "id": "relaymind-client-tools",
            "name": "RelayMind client-owned tools (config row)",
