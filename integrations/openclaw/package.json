{
  "name": "@relaymind/openclaw-provider",
  "version": "0.1.0",
  "private": true,
  "description": "RelayMind provider plugin for OpenClaw: the client-owned alias relaymind-client-tools over the loopback chat API (RM33).",
  "type": "module",
  "main": "./dist/index.js",
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md"
  ],
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "providers": [
      "relaymind"
    ],
    "compat": {
      "pluginApi": "2026.10.7",
      "minGatewayVersion": "2026.10.7"
    },
    "build": {
      "openclawVersion": "2026.10.7",
      "pluginSdkVersion": "2026.10.7"
    }
  },
  "peerDependencies": {
    "openclaw": "2026.10.7"
  },
  "devDependencies": {
    "@openclaw/ai": "2026.10.7",
    "@types/node": "24.19.2",
    "openclaw": "2026.10.7",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=24.22.1 <25 || >=26.12.1"
  },
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "pack:check": "npm run build && node scripts/pack-check.mjs"
  }
}
