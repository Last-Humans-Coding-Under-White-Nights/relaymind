{
  "id": "relaymind",
  "name": "RelayMind",
  "description": "RelayMind local gateway as an OpenClaw model provider: the client-owned alias relaymind-client-tools over the loopback chat API; OpenClaw keeps its sessions, tools, and approvals.",
  "categories": [
    "models"
  ],
  "activation": {
    "onStartup": false,
    "onConfigPaths": [
      "plugins.entries.relaymind.config.recommendations"
    ]
  },
  "providers": [
    "relaymind"
  ],
  "setup": {
    "providers": [
      {
        "id": "relaymind",
        "envVars": [
          "RELAYMIND_APP_TOKEN"
        ]
      }
    ]
  },
  "providerAuthChoices": [
    {
      "provider": "relaymind",
      "method": "api-key",
      "choiceId": "relaymind-app-token",
      "choiceLabel": "RelayMind application token",
      "choiceHint": "The token `relaymind serve` printed when it started",
      "groupId": "relaymind",
      "groupLabel": "RelayMind",
      "groupHint": "Local gateway (loopback only)",
      "optionKey": "relaymindAppToken",
      "cliFlag": "--relaymind-app-token",
      "cliOption": "--relaymind-app-token <token>",
      "cliDescription": "RelayMind application token (printed by relaymind serve at each start)"
    }
  ],
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "baseUrl"
    ],
    "properties": {
      "baseUrl": {
        "type": "string",
        "description": "The gateway's loopback /v1 URL, such as http://127.0.0.1:8080/v1 (localhost, 127.0.0.0/8, or [::1] only)."
      },
      "diagnosticsPath": {
        "type": "string",
        "minLength": 1,
        "description": "Optional absolute file path: one JSON line per inference attempt (turn, attempt, Idempotency-Key, RelayMind run ID or unavailable, outcome, code, native run and UI links). Never the token or message content."
      },
      "executionMode": {
        "type": "string",
        "enum": [
          "auto",
          "local_only",
          "external_only"
        ],
        "default": "auto",
        "description": "Sent as X-RelayMind-Execution-Mode on every request. parallel_demo is not a mode of this alias."
      },
      "limits": {
        "type": "object",
        "additionalProperties": false,
        "description": "Copies of the gateway's configured limits; a limit not set is not advertised.",
        "properties": {
          "externalContextLimit": {
            "type": "integer",
            "minimum": 1,
            "description": "external_model.context_limit of the gateway's launch file; the window advertised in auto and external_only."
          },
          "localContextLimit": {
            "type": "integer",
            "minimum": 1,
            "description": "The local context of the pinned model manifest's launch settings; the window advertised in local_only."
          },
          "maxCompletionTokens": {
            "type": "integer",
            "minimum": 1,
            "description": "chat.max_completion_tokens of the gateway's launch file; the advertised output limit."
          }
        }
      },
      "maxRetries": {
        "type": "integer",
        "minimum": 0,
        "maximum": 2,
        "default": 0,
        "description": "The plugin's own retries after 429 overloaded (same Idempotency-Key) or 504 deadline_exceeded (a new key), only before any answer content. 0 is one attempt."
      },
      "recommendations": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "controlUiOrigin",
          "applicationTokenEnv",
          "bindings"
        ],
        "properties": {
          "controlUiOrigin": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "applicationTokenEnv": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$"
          },
          "bindings": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1000,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "profileId",
                "authenticatedUserId",
                "agentId",
                "userId",
                "workspaceId",
                "workspaceDir",
                "actionTokenEnv"
              ],
              "properties": {
                "profileId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "authenticatedUserId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "agentId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "userId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "workspaceId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "workspaceDir": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048
                },
                "actionTokenEnv": {
                  "type": "string",
                  "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$"
                }
              }
            }
          },
          "skills": {
            "type": "array",
            "maxItems": 1000,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "assetId",
                "contentHash",
                "sourceVersion",
                "skillId",
                "revision"
              ],
              "properties": {
                "assetId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "contentHash": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "sourceVersion": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 256
                },
                "skillId": {
                  "type": "string",
                  "pattern": "^[a-f0-9-]{36}$"
                },
                "revision": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            }
          }
        }
      }
    }
  },
  "contracts": {
    "gatewayMethodDispatch": [
      "authenticated-request"
    ]
  },
  "controlUi": {
    "entry": "dist/control-ui/control-ui.js"
  }
}
