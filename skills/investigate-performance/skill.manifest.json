{
  "schema_version": 1,
  "version": "0.2.0",
  "languages": [
    "en",
    "zh"
  ],
  "local_eligible": false,
  "allowed_tools": [
    "get_latest_deployment",
    "get_metrics",
    "get_recent_logs"
  ],
  "resources": [
    "examples.json"
  ],
  "completion_predicate": "performance_evidence_separated",
  "parallel_workflow": null,
  "prefetch": [
    {
      "tool": "get_latest_deployment",
      "arguments": {
        "service": {
          "from": "request"
        }
      }
    },
    {
      "tool": "get_recent_logs",
      "arguments": {
        "service": {
          "from": "request"
        },
        "limit": {
          "constant": 50
        }
      }
    }
  ]
}
