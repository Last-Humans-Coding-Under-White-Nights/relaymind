{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "identity": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false
    },
    "manifest": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "manifest_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "representation": {
      "type": "object",
      "properties": {
        "version": {
          "const": "task_text.v1"
        },
        "normalization": {
          "const": "NFC"
        },
        "query_prefix": {
          "type": "string",
          "maxLength": 256
        },
        "max_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8192
        },
        "overflow": {
          "const": "unavailable"
        }
      },
      "required": [
        "version",
        "normalization",
        "query_prefix",
        "max_tokens",
        "overflow"
      ],
      "additionalProperties": false
    },
    "similarity": {
      "type": "object",
      "properties": {
        "version": {
          "const": "exact_cosine.v1"
        },
        "threshold": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        }
      },
      "required": [
        "version",
        "threshold"
      ],
      "additionalProperties": false
    },
    "ranking_version": {
      "const": "bounded_votes.v1"
    }
  },
  "required": [
    "schema_version",
    "identity",
    "manifest",
    "manifest_digest",
    "representation",
    "similarity",
    "ranking_version"
  ],
  "additionalProperties": false
}
