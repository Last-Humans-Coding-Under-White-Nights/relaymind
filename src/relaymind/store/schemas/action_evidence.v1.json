{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://relaymind.local/schemas/action_evidence.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "adapter_id",
    "scope",
    "recommendation_id",
    "task_id",
    "choice",
    "catalog_revision",
    "host_snapshot_revision",
    "recorded_at",
    "state_version"
  ],
  "properties": {
    "adapter_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "user_id",
        "workspace_id"
      ],
      "properties": {
        "user_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "workspace_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "recommendation_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "choice": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "asset_id",
            "content_hash"
          ],
          "properties": {
            "kind": {
              "const": "asset"
            },
            "asset_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "content_hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "none"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "cancel"
            }
          }
        }
      ]
    },
    "catalog_revision": {
      "type": "integer",
      "minimum": 0
    },
    "host_snapshot_revision": {
      "type": "null"
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "state_version": {
      "type": "integer",
      "minimum": 0
    }
  }
}
