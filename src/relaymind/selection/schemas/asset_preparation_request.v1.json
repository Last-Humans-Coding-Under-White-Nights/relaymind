{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "preparation_id",
    "operation",
    "binding",
    "profile",
    "catalog",
    "budget_ms"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "preparation_id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}(?![\\s\\S])"
    },
    "operation": {
      "enum": [
        "prepare",
        "status",
        "cancel"
      ]
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selector",
        "catalog_revision",
        "catalog_digest",
        "scope",
        "permissions",
        "selection_scope",
        "requested_kinds"
      ],
      "properties": {
        "selector": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "version"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        },
        "catalog_revision": {
          "type": "integer",
          "minimum": 0
        },
        "catalog_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "user_id",
            "workspace_id"
          ],
          "properties": {
            "user_id": {
              "type": "string",
              "minLength": 1
            },
            "workspace_id": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "permissions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "selection_scope": {
          "enum": [
            "discovery",
            "runtime"
          ]
        },
        "requested_kinds": {
          "type": "array",
          "items": {
            "enum": [
              "skill",
              "mcp_tool"
            ]
          },
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true
        }
      }
    },
    "profile": {
      "enum": [
        "cold",
        "reuse"
      ]
    },
    "catalog": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "schema_version",
              "asset_id",
              "kind",
              "source_id",
              "source_locator",
              "source_version",
              "captured_at",
              "content_hash",
              "description",
              "language_tags",
              "dependencies",
              "availability",
              "stale",
              "identity"
            ],
            "properties": {
              "schema_version": {
                "const": 1
              },
              "asset_id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "enum": [
                  "skill",
                  "mcp_tool"
                ]
              },
              "source_id": {
                "type": "string",
                "minLength": 1
              },
              "source_locator": {
                "type": "string",
                "minLength": 1
              },
              "source_version": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1
              },
              "captured_at": {
                "type": "string",
                "minLength": 1
              },
              "content_hash": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "language_tags": {
                "type": "array",
                "maxItems": 32,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9-]{1,64}(?![\\s\\S])"
                }
              },
              "dependencies": {
                "type": "array",
                "maxItems": 64,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "availability": {
                "enum": [
                  "available",
                  "needs_setup",
                  "unavailable",
                  "unknown"
                ]
              },
              "stale": {
                "type": "boolean"
              },
              "identity": {
                "type": "object"
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "kind": {
                      "const": "skill"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "identity": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "package_id",
                        "package_version"
                      ],
                      "properties": {
                        "package_id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "package_version": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "minLength": 1
                        }
                      }
                    }
                  }
                },
                "else": {
                  "properties": {
                    "identity": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "server_id",
                        "tool_name",
                        "exposed_name",
                        "input_schema",
                        "schema_hash"
                      ],
                      "properties": {
                        "server_id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "tool_name": {
                          "type": "string",
                          "minLength": 1
                        },
                        "exposed_name": {
                          "type": "string",
                          "minLength": 1
                        },
                        "input_schema": {
                          "type": "object"
                        },
                        "schema_hash": {
                          "type": "string",
                          "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
                        }
                      }
                    }
                  }
                }
              }
            ]
          },
          "maxItems": 1000
        },
        {
          "type": "null"
        }
      ]
    },
    "budget_ms": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 600000
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "const": "prepare"
          }
        }
      },
      "then": {
        "properties": {
          "catalog": {
            "type": "array",
            "items": {
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "type": "object",
              "additionalProperties": false,
              "required": [
                "schema_version",
                "asset_id",
                "kind",
                "source_id",
                "source_locator",
                "source_version",
                "captured_at",
                "content_hash",
                "description",
                "language_tags",
                "dependencies",
                "availability",
                "stale",
                "identity"
              ],
              "properties": {
                "schema_version": {
                  "const": 1
                },
                "asset_id": {
                  "type": "string",
                  "minLength": 1
                },
                "kind": {
                  "enum": [
                    "skill",
                    "mcp_tool"
                  ]
                },
                "source_id": {
                  "type": "string",
                  "minLength": 1
                },
                "source_locator": {
                  "type": "string",
                  "minLength": 1
                },
                "source_version": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "minLength": 1
                },
                "captured_at": {
                  "type": "string",
                  "minLength": 1
                },
                "content_hash": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                },
                "language_tags": {
                  "type": "array",
                  "maxItems": 32,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9-]{1,64}(?![\\s\\S])"
                  }
                },
                "dependencies": {
                  "type": "array",
                  "maxItems": 64,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "availability": {
                  "enum": [
                    "available",
                    "needs_setup",
                    "unavailable",
                    "unknown"
                  ]
                },
                "stale": {
                  "type": "boolean"
                },
                "identity": {
                  "type": "object"
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "kind": {
                        "const": "skill"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "identity": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "package_id",
                          "package_version"
                        ],
                        "properties": {
                          "package_id": {
                            "type": "string",
                            "minLength": 1
                          },
                          "package_version": {
                            "type": [
                              "string",
                              "null"
                            ],
                            "minLength": 1
                          }
                        }
                      }
                    }
                  },
                  "else": {
                    "properties": {
                      "identity": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "server_id",
                          "tool_name",
                          "exposed_name",
                          "input_schema",
                          "schema_hash"
                        ],
                        "properties": {
                          "server_id": {
                            "type": "string",
                            "minLength": 1
                          },
                          "tool_name": {
                            "type": "string",
                            "minLength": 1
                          },
                          "exposed_name": {
                            "type": "string",
                            "minLength": 1
                          },
                          "input_schema": {
                            "type": "object"
                          },
                          "schema_hash": {
                            "type": "string",
                            "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
                          }
                        }
                      }
                    }
                  }
                }
              ]
            },
            "maxItems": 1000
          },
          "budget_ms": {
            "type": "integer",
            "minimum": 1,
            "maximum": 600000
          }
        }
      },
      "else": {
        "properties": {
          "catalog": {
            "type": "null"
          },
          "budget_ms": {
            "type": "null"
          }
        }
      }
    }
  ]
}
