{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "recommendation_id",
    "catalog_revision",
    "host_snapshot_revision",
    "selector",
    "mechanism",
    "outcome",
    "decision",
    "candidates",
    "index_revision",
    "elapsed_ms",
    "usage_claims"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "recommendation_id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}(?![\\s\\S])"
    },
    "catalog_revision": {
      "type": "integer",
      "minimum": 0
    },
    "host_snapshot_revision": {
      "type": "null"
    },
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "mechanism": {
      "type": "string",
      "minLength": 1
    },
    "outcome": {
      "enum": [
        "ranked",
        "no_match",
        "not_ready",
        "unavailable"
      ]
    },
    "decision": {
      "enum": [
        "confident",
        "choice_required",
        "no_match",
        null
      ]
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "asset_id",
          "kind",
          "content_hash",
          "source_version",
          "score",
          "score_kind",
          "evidence_refs"
        ],
        "properties": {
          "asset_id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "skill",
              "mcp_tool"
            ]
          },
          "content_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
          },
          "source_version": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "score": {
            "type": "number"
          },
          "score_kind": {
            "type": "string",
            "minLength": 1
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(?:/(?:[^~]|~[01])*)?(?![\\s\\S])"
            },
            "uniqueItems": true,
            "maxItems": 32
          },
          "availability": {
            "enum": [
              "available",
              "needs_setup",
              "unavailable",
              "unknown"
            ]
          }
        }
      },
      "maxItems": 10
    },
    "index_revision": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "elapsed_ms": {
      "type": "number",
      "minimum": 0
    },
    "usage_claims": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provenance",
            "value"
          ],
          "properties": {
            "provenance": {
              "const": "reported"
            },
            "value": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "input_tokens",
                "output_tokens",
                "cached_tokens",
                "reasoning_tokens",
                "calls",
                "cpu_ms",
                "peak_bytes"
              ],
              "properties": {
                "input_tokens": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "output_tokens": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "cached_tokens": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "reasoning_tokens": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "calls": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "cpu_ms": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "peak_bytes": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "ranked"
          }
        }
      },
      "then": {
        "properties": {
          "decision": {
            "enum": [
              "confident",
              "choice_required"
            ]
          },
          "candidates": {
            "minItems": 1,
            "maxItems": 10
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "no_match"
          }
        }
      },
      "then": {
        "properties": {
          "decision": {
            "enum": [
              "no_match"
            ]
          },
          "candidates": {
            "minItems": 0,
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "not_ready"
          }
        }
      },
      "then": {
        "properties": {
          "decision": {
            "enum": [
              null
            ]
          },
          "candidates": {
            "minItems": 0,
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "unavailable"
          }
        }
      },
      "then": {
        "properties": {
          "decision": {
            "enum": [
              null
            ]
          },
          "candidates": {
            "minItems": 0,
            "maxItems": 0
          }
        }
      }
    }
  ]
}
