{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "preparation_id",
    "binding",
    "profile",
    "state",
    "index_revision",
    "reused",
    "elapsed_ms",
    "usage_claims",
    "reason"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "preparation_id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}(?![\\s\\S])"
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selector",
        "catalog_revision",
        "catalog_digest",
        "scope",
        "permissions",
        "selection_scope",
        "requested_kinds"
      ],
      "properties": {
        "selector": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "version"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        },
        "catalog_revision": {
          "type": "integer",
          "minimum": 0
        },
        "catalog_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "user_id",
            "workspace_id"
          ],
          "properties": {
            "user_id": {
              "type": "string",
              "minLength": 1
            },
            "workspace_id": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "permissions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "selection_scope": {
          "enum": [
            "discovery",
            "runtime"
          ]
        },
        "requested_kinds": {
          "type": "array",
          "items": {
            "enum": [
              "skill",
              "mcp_tool"
            ]
          },
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true
        }
      }
    },
    "profile": {
      "enum": [
        "cold",
        "reuse"
      ]
    },
    "state": {
      "enum": [
        "indexing",
        "ready",
        "failed",
        "cancelled",
        "stale_catalog"
      ]
    },
    "index_revision": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        {
          "type": "null"
        }
      ]
    },
    "reused": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "elapsed_ms": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "usage_claims": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provenance",
            "value"
          ],
          "properties": {
            "provenance": {
              "const": "reported"
            },
            "value": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "input_tokens",
                "output_tokens",
                "cached_tokens",
                "reasoning_tokens",
                "calls",
                "cpu_ms",
                "peak_bytes"
              ],
              "properties": {
                "input_tokens": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "output_tokens": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "cached_tokens": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "reasoning_tokens": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "calls": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "cpu_ms": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "peak_bytes": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          }
        }
      ]
    },
    "reason": {
      "enum": [
        null,
        "build_failed",
        "deadline_exceeded",
        "cancelled",
        "catalog_stale",
        "unknown_preparation",
        "identity_conflict",
        "unsupported_profile"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "ready"
          }
        }
      },
      "then": {
        "properties": {
          "index_revision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "reused": {
            "type": "boolean"
          },
          "reason": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "index_revision": {
            "type": "null"
          },
          "reused": {
            "type": "null"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "state": {
                  "const": "indexing"
                }
              }
            },
            "then": {
              "properties": {
                "reason": {
                  "type": "null"
                }
              }
            },
            "else": {
              "properties": {
                "reason": {
                  "enum": [
                    "build_failed",
                    "deadline_exceeded",
                    "cancelled",
                    "catalog_stale",
                    "unknown_preparation",
                    "identity_conflict",
                    "unsupported_profile"
                  ]
                }
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "ready"
          },
          "profile": {
            "const": "cold"
          }
        }
      },
      "then": {
        "properties": {
          "reused": {
            "const": false
          }
        }
      }
    }
  ]
}
